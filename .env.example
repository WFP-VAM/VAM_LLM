GOOGLE_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
MFI_MARKET_DRAFT_TIMEOUT_SECONDS=180
MFI_RED_TEAM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=2
# Metadata-only tracing is the default. Enable payload capture only after the
# private GCS bucket has the documented 30-day lifecycle and restricted IAM.
LLM_TRACE_PAYLOADS=false
LLM_TRACE_GCS_URI=
TE_API_KEY=
SEERIST_API_KEY=

# New WFP API Gateway / Databridges v2 credentials.
WFP_V2_API_KEY=
WFP_V2_API_SECRET=
WFP_V2_API_BASE_URL=https://gateway.api.wfp.org/vam-data-bridges/v2
WFP_V2_TOKEN_URL=https://login.microsoftonline.com/462ad9ae-d7d9-4206-b874-71b1e079776f/oauth2/v2.0/token
WFP_V2_API_SCOPE=api://wfp-api-mediation-service/.default
WFP_V2_API_ENV=prod

# Compatibility aliases for older deployments. WFP_V2_* values take precedence.
DATA_BRIDGES_KEY=
DATA_BRIDGES_SECRET=
DATA_BRIDGES_API_BASE_URL=https://gateway.api.wfp.org/vam-data-bridges/v2
DATA_BRIDGES_TOKEN_URL=https://login.microsoftonline.com/462ad9ae-d7d9-4206-b874-71b1e079776f/oauth2/v2.0/token
DATA_BRIDGES_SCOPE=api://wfp-api-mediation-service/.default
DATA_BRIDGES_TIMEOUT=60
DATA_BRIDGES_MAX_RETRIES=3
DATA_BRIDGES_ENV=prod
DATA_BRIDGES_PAGE_SIZE=1000
DATA_BRIDGES_MAX_WORKERS=5
DATA_BRIDGES_REQUEST_TIMEOUT_SECONDS=60
DATA_BRIDGES_RETRY_BACKOFF_SECONDS=1

MARKET_NAMES_GCS_URI=

# Optional existing async-run storage, also used by MFI recovery.
# Leave unset to retain the default in-memory backend on local and cloud hosts.
# Memory progress/Resume is limited to the same live server process.
# For an already configured durable deployment, preserve its existing values:
# RUNS_BACKEND=firestore_gcs
# RUNS_GCS_URI=gs://<existing-bucket>/<existing-prefix>
# RUNS_FIRESTORE_DATABASE=<existing-database>
# RUNS_FIRESTORE_COLLECTION=async_runs

# Phase 3 app-owned price cache foundation.
PRICE_CACHE_BACKEND=sqlite
PRICE_CACHE_SQLITE_PATH=.tmp/price_cache.sqlite3
PRICE_CACHE_RETAIN_VERSIONS=3
PRICE_CACHE_DATABASE_URL=
PRICE_CACHE_GCP_PROJECT=
PRICE_CACHE_GCP_REGION=europe-west1
PRICE_CACHE_GCP_CLOUD_SQL_INSTANCE=vam-llm-price-cache-beta
PRICE_CACHE_REFRESH_ENABLED=true
PRICE_CACHE_REFRESH_LOCK_TIMEOUT_MINUTES=30
PRICE_CACHE_VALIDATE_MAX_COUNTRY_DROP_RATIO=0.25
PRICE_CACHE_REFRESH_START_DATE=
PRICE_CACHE_REFRESH_END_DATE=
PRICE_CACHE_REFRESH_MAX_WORKERS=5
PRICE_CACHE_POOL_RECYCLE_SECONDS=240
PRICE_CACHE_POOL_TIMEOUT_SECONDS=30

# Cloud Run / Cloud SQL idle-connection hardening (postgres backend only).
# tcp_user_timeout is ignored on platforms without TCP_USER_TIMEOUT support
# (e.g. Windows/macOS dev machines); the sqlite backend ignores all of these.
PRICE_CACHE_CONNECT_TIMEOUT_SECONDS=10
PRICE_CACHE_TCP_KEEPALIVES_IDLE_SECONDS=30
PRICE_CACHE_TCP_KEEPALIVES_INTERVAL_SECONDS=10
PRICE_CACHE_TCP_KEEPALIVES_COUNT=3
PRICE_CACHE_TCP_USER_TIMEOUT_MS=30000
PRICE_CACHE_STATEMENT_TIMEOUT_MS=120000

# Default-on second food basket. Set false for a reversible primary-only operational rollback.
MARKET_MONITOR_SECOND_BASKET_ENABLED=true

# Seasonal Outlook: explicit company configuration; never infer a personal project.
# Enabled by default; requires the company Job, storage and IAM configuration below.
# Set false to stop new processing while keeping history and downloads available.
SEASONAL_DRAFTER_ENABLED=true
SEASONAL_PROJECT=
SEASONAL_BUCKET=
SEASONAL_DATABASE=vam-llm-async
SEASONAL_COLLECTION=seasonal_outlook_runs
SEASONAL_PREFIX=seasonal-outlook
SEASONAL_JOB=
SEASONAL_JOB_REGION=
SEASONAL_SIGNER=
SEASONAL_MODEL=gemini-3.1-pro-preview
SEASONAL_LOCATION=global
